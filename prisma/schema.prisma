// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------
// Enums
// ----------------------------------------

enum UserRole {
  CUSTOMER
  WAITER
  KITCHEN
  ADMIN
  SUPER_ADMIN
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TableStatus {
  FREE
  OCCUPIED
  BILLING
}

enum SessionStatus {
  ACTIVE
  BILLING
  CLOSED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  PLACED
  PREPARING
  READY
  SERVED
  BILLED
  CANCELLED
}

enum OrderSource {
  CUSTOMER_APP
  STAFF_MANUAL
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemSource {
  CUSTOMER_APP
  STAFF_MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ----------------------------------------
// Models
// ----------------------------------------

model Restaurant {
  id          String           @id @default(uuid())
  name        String
  address     String?
  gstNumber   String?
  status      RestaurantStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  tables      Table[]
  categories  MenuCategory[]
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(CUSTOMER)

  restaurantId String?
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])

  manualItems  OrderItem[]  @relation("StaffManualItems")

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Table {
  id           String         @id @default(uuid())
  tableNumber  String
  qrTableCode  String         @unique
  status       TableStatus    @default(FREE)

  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])

  sessions     TableSession[]
  reservations Reservation[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model MenuCategory {
  id           String       @id @default(uuid())
  name         String
  sortOrder    Int          @default(0)

  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])

  items        MenuItem[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model MenuItem {
  id          String       @id @default(uuid())
  name        String
  price       Decimal      @db.Decimal(10, 2)
  isVeg       Boolean      @default(true)
  isAvailable Boolean      @default(true)

  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])

  orderItems  OrderItem[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TableSession {
  id             String        @id @default(uuid())
  tableId        String
  table          Table         @relation(fields: [tableId], references: [id])
  sessionToken   String        @unique
  status         SessionStatus @default(ACTIVE)

  orders         Order[]
  bills          Bill[]

  startedAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())
  endedAt        DateTime?
}

model Order {
  id             String       @id @default(uuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])

  status         OrderStatus  @default(PLACED)
  source         OrderSource  @default(CUSTOMER_APP)
  totalAmount    Decimal      @default(0) @db.Decimal(10, 2)

  items          OrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])

  menuItemId     String
  menuItem       MenuItem        @relation(fields: [menuItemId], references: [id])

  quantity       Int             @default(1)
  itemStatus     OrderItemStatus @default(PENDING)
  source         OrderItemSource @default(CUSTOMER_APP)

  addedByStaffId String?
  addedByStaff   User?           @relation("StaffManualItems", fields: [addedByStaffId], references: [id])

  notes          String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Bill {
  id             String       @id @default(uuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])

  subtotal       Decimal      @db.Decimal(10, 2)
  tax            Decimal      @db.Decimal(10, 2)
  discount       Decimal      @default(0) @db.Decimal(10, 2)
  grandTotal     Decimal      @db.Decimal(10, 2)

  payments       Payment[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Payment {
  id         String        @id @default(uuid())
  billId     String
  bill       Bill          @relation(fields: [billId], references: [id])

  method     String
  gatewayRef String?
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Reservation {
  id           String            @id @default(uuid())
  tableId      String
  table        Table             @relation(fields: [tableId], references: [id])

  customerName String
  phone        String
  slotTime     DateTime
  status       ReservationStatus @default(PENDING)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}